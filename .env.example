# docker compose подхватывает переменные из .env (см. docker-compose.yml)
# Каталог моделей на хосте (volume /models в контейнере):
WHISPER_MODELS_DIR=
# Внутри контейнера всегда /models (см. docker-compose.yml)

# Автозагрузка turbo с Hugging Face при старте (как VLM_DOWNLOAD_MODELS в video-descriptor-rkllm):
WHISPER_DOWNLOAD_MODELS=turbo
WHISPER_MODEL_PROFILE=turbo
# Язык аудио (ru, en, uk, …) — без этого turbo может распознавать не на том языке
WHISPER_LANGUAGE=ru

# Ядра NPU RK3588: 0 | 0_1 | 0_1_2 | all | auto — encoder pool и single-encoder
WHISPER_NPU_CORE_MASK=0_1_2

# Параллельный encode: VAD-нарезка в RAM + пул encoder на ядрах 0/1/2 (см. docs/models.md)
WHISPER_PARALLEL_ENCODE=1
# 0 = auto: MemAvailable pick N→…→1, затем NPU probe при MALLOC_FAIL
WHISPER_ENCODER_WORKERS=0
# Потолок воркеров (по умолчанию = число разрешённых NPU cores)
# WHISPER_ENCODER_MAX_WORKERS=3

# Воркеры encoder/decoder (gateway не использует):
# WHISPER_CPU_AFFINITY=4,5,6,7
# WHISPER_CPU_AFFINITY=4-7
# WHISPER_ONNX_INTRA_OP_THREADS=0

WHISPER_MAX_CHUNK_SECONDS=30
WHISPER_VAD_THRESHOLD=0.5
WHISPER_VAD_SEARCH_BACK_SEC=3
WHISPER_VAD_MIN_GAP_MS=250
# Мелкие сегменты для verbose_json/srt/vtt (decode-окна 30 с не трогает):
# WHISPER_VAD_SEGMENT_MAX_SECONDS=5
# WHISPER_VAD_SEGMENT_MIN_GAP_MS=100
# WHISPER_VAD_SEGMENT_SEARCH_BACK_FRAMES=16

# Длинное аудио (>30 с): скользящие окна и склейка текста (см. docs/api.md)
# WHISPER_CHUNK_SECONDS=30
# WHISPER_CHUNK_OVERLAP_SECONDS=2
# WHISPER_MIN_TAIL_SECONDS=8
WHISPER_DECODER_BACKEND=onnx
WHISPER_DECODER=/models/decoder.onnx
# 0/auto = до EOT или n_text_ctx (448); положительное число — мягкий потолок
# WHISPER_MAX_DECODE_TOKENS=0
# WHISPER_TRUNCATE_RETRY_SECONDS=10  # при обрыве без EOT — переслушать хвост
# WHISPER_MAX_NGRAM_REPEAT=6

# Порт внутри Docker-сети (бот ждёт 9003)
PORT=9003

# Лимит загрузки POST /v1/audio/transcriptions (МБ)
# MAX_UPLOAD_MB=25

# Верхняя граница длительности аудио для оценки RAM запроса (секунды)
# WHISPER_MAX_AUDIO_SECONDS=600

# API key (OpenAI-style Bearer). Если задан — POST /v1/audio/* требует
#   Authorization: Bearer <key>
# WHISPER_API_KEY=sk-your-secret
# Альтернатива для OpenAI SDK / клиентов:
# OPENAI_API_KEY=sk-your-secret

# Свои URL (опционально):
# WHISPER_MODEL_URLS=encoder.rknn=https://example.com/encoder.rknn

# Fallback CLI ffmpeg (если PyAV недоступен; по умолчанию /usr/bin/ffmpeg из образа)
# FFMPEG_BIN=/usr/bin/ffmpeg

# OpenAI SDK: OPENAI_BASE_URL=http://whisper-rknn-api:${PORT}/v1
# Создание сети: docker network create whisper_rknn_default

# --- Распределённый режим (docker-compose.distributed.yml / k3s) ---
# WHISPER_ROLE=gateway|encoder|decoder  (задаётся в compose/k8s, не в .env monolith)
# ENCODER_TARGETS=encoder-0:50051
# DECODER_TARGETS=decoder-0:50052
# MAX_INFLIGHT_JOBS=2
# См. docs/architecture.md
