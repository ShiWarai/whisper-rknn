# docker compose подхватывает переменные из .env (см. docker-compose.yml)
# Каталог моделей на хосте (volume /models в контейнере):
WHISPER_MODELS_DIR=/mnt/nvme0/models/whisper-rknn-turbo

# Автозагрузка turbo с Hugging Face при старте (как VLM_DOWNLOAD_MODELS в video-descriptor-rkllm):
WHISPER_DOWNLOAD_MODELS=turbo
WHISPER_MODEL_PROFILE=turbo
# Язык аудио (ru, en, uk, …) — без этого turbo может распознавать не на том языке
WHISPER_LANGUAGE=ru

# Ядра NPU RK3588: 0 | 0_1 | 0_1_2 | all | auto (по умолчанию все три)
WHISPER_NPU_CORE_MASK=0_1_2

# Порт внутри Docker-сети (бот ждёт 9003)
PORT=9003

# Свои URL (опционально):
# WHISPER_MODEL_URLS=encoder.rknn=https://example.com/encoder.rknn

# API: http://whisper-rknn-api:${PORT}
# Создание сети: docker network create whisper_rknn_default
