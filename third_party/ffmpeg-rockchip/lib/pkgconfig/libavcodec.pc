prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: libavcodec
Description: FFmpeg codec library
Version: 62.28.102
Requires: libavutil >= 60.26.102
Conflicts:
Libs: -L${libdir} -lavcodec
Libs.private: -lm -lz -ldrm -lssl -lcrypto -lopus -lmp3lame -lvorbis -lvorbisenc -pthread
Cflags: -I${includedir}
